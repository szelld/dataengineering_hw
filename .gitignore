# Environment secrets
.env
.env_old
metabaselogin.txt

# Python artifacts
__pycache__/
*.pyc

# Airflow runtime logs (large, machine-specific)
logs/
*.log

# LaTeX source (kept local; the compiled Dataeng.pdf is what ships)
doku.tex

# LaTeX build artifacts
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Generated pipeline artifacts (regenerated by the Airflow backfill / daily runs).
# The landing zone (data/raw) and transform cache (data/processed) are pipeline
# OUTPUTS, so they are not committed. The directories are kept via .gitkeep, and
# the curated reference inputs under data/reference/ stay tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
